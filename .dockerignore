# Build context allowlist. Secrets, backups, uploads, generated output and
# local diagnostic scripts never reach the Docker builder.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**
!prisma/
!prisma/schema.prisma
!prisma/seed.ts
!prisma/migrations/
!prisma/migrations/**
!test/
!test/**
!scripts/
!scripts/prune-runtime.mjs
