# Run node scripts/setup-docker-env.mjs to create .env.docker with random secrets.
# Keep passwords URL-safe (hex is recommended) because they enter connection URLs.
POSTGRES_DB=mandisetu
POSTGRES_USER=mandisetu
POSTGRES_PASSWORD=replace_with_random_hex
REDIS_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_at_least_32_random_characters
WEB_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://mandisetu-users.vercel.app,https://mandisetu-sellers.vercel.app
TRUST_PROXY=0
BACKEND_PORT=4000
POSTGRES_PORT=15432
REDIS_PORT=16379
BACKEND_IMAGE=mandisetu-backend:local
UPLOADS_PATH=/srv/mandisetu/uploads
