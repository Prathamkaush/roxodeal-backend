{
  "name": "@mandisetu/backend",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  },
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "npm run build && node scripts/live-integration.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "configure:local": "node scripts/configure-local-env.mjs",
    "package:server": "node scripts/package-server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.12.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "prisma": "6.12.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
